### production ###

#### Time step
reset_timestep  0
timestep        ${dt} #fs
timestep        10 

### Ensemble / Thermostat
run_style       verlet
velocity        all create $T ${seedV}
velocity        all create 307 ${seedV}
velocity        all create 307 4928421
fix             fix1 all nve
fix             fix2 all langevin $T $T ${damp} ${seedT}
fix             fix2 all langevin 307 $T ${damp} ${seedT}
fix             fix2 all langevin 307 307 ${damp} ${seedT}
fix             fix2 all langevin 307 307 1000 ${seedT}
fix             fix2 all langevin 307 307 1000 3278431

### Outputting useful information in the log file
thermo          ${thermointrv}
thermo          100000
thermo_style    custom step temp pe ke evdwl ecoul ebond eangle

# Saving the simulation snapshots in a trajectory file
dump            mydump1 all custom ${dumpintrv} dna.dumplammps.* id type x y z ix iy iz
dump            mydump1 all custom 100000 dna.dumplammps.* id type x y z ix iy iz
dump_modify     mydump1 sort id

# Specifying the runlength
run             ${runtime}
run             10000000
